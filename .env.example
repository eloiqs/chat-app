# Docker Compose Configuration
# Copy this file to .env and modify as needed

# PostgreSQL
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp
POSTGRES_DB=chatapp_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API Server
SERVER_PORT=3001

# WebSocket Gateway
WS_PORT=3002

# web-client (nginx)
CLIENT_PORT=5173

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:${CLIENT_PORT:-5173}

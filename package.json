{
  "name": "chat-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "shared",
    "web-client",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web-client",
    "dev:server": "npm run dev --workspace=server",
    "dev:all": "npm run dev --workspace=web-client & npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:e2e": "npm test --workspace=e2e",
    "test:e2e:ui": "npm run test:ui --workspace=e2e",
    "test:e2e:headed": "npm run test:headed --workspace=e2e"
  },
  "devDependencies": {
    "prettier": "^3.7.3"
  },
  "dependencies": {}
}

{
  "name": "chat-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "shared",
    "web-client",
    "server",
    "ws-gateway",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web-client",
    "dev:server": "npm run dev --workspace=server",
    "dev:ws": "npm run dev --workspace=ws-gateway",
    "dev:all": "npm run dev --workspace=server & npm run dev --workspace=ws-gateway & npm run dev --workspace=web-client",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:e2e": "npm test --workspace=e2e",
    "test:e2e:ui": "npm run test:ui --workspace=e2e",
    "test:e2e:headed": "npm run test:headed --workspace=e2e",
    "test:e2e:report": "npm run report --workspace=e2e",
    "e2e:up": "docker compose --env-file .env.e2e -p e2e up -d --build --wait",
    "e2e:down": "docker compose -p e2e down -v",
    "e2e:logs": "docker compose -p e2e logs -f",
    "docker:infra": "docker compose -p infra up -d postgres redis migrate",
    "docker:infra:down": "docker compose -p infra down",
    "docker:up": "docker compose -p dev up -d --build",
    "docker:down": "docker compose -p dev down",
    "docker:build": "docker compose -p dev build",
    "docker:logs": "docker compose -p dev logs -f",
    "docker:clean": "docker compose -p dev down -v --remove-orphans",
    "db:generate": "npm run db:generate --workspace=server",
    "db:deploy": "npm run db:deploy --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:studio": "npm run db:studio --workspace=server"
  },
  "devDependencies": {
    "prettier": "^3.7.3"
  },
  "dependencies": {}
}
